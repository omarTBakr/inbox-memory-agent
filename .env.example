# Copy to .env (`make env` does this and generates the secrets).
# Comments stay on their own lines: make keeps trailing text on value lines.

# ===== Models (defaults; the UI saves its own choice in Postgres) =====
# ollama | anthropic | openai | openai_compatible | google_genai (see config/options.yml)
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Chat model must support tool calling
LLM_MODEL=gemma4:e4b
LLM_TEMPERATURE=0
LLM_NUM_CTX=8192
# Thinking mode for reasoning models; slower, off by default
LLM_REASONING=false
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMS=768

# ===== User profile / data / prompts =====
USER_PROFILE_PATH=config/user_profile.yml
# Choices offered by the UI (tones, languages, providers, ...)
OPTIONS_PATH=config/options.yml
# Prices synced into Langfuse for models it doesn't know (`make langfuse-models`)
MODEL_PRICES_PATH=config/model_prices.yml
# Setup guides shown in the UI and rendered to SETUP_GUIDE_DOC by `make docs`
GUIDES_PATH=config/guides.yml
SETUP_GUIDE_DOC=docs/SETUP_GUIDE.md
SAMPLE_EMAILS_PATH=data/sample_emails.yml
PROMPTS_DIR=prompts
# local = read prompts/ files; langfuse = fetch PROMPT_LABEL version from Langfuse
PROMPT_SOURCE=local
PROMPT_LABEL=production

# ===== PostgreSQL (memory store + checkpointer; also hosts mlflow + langfuse DBs) =====
# Host port; 5433 avoids clashing with a locally installed Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=email_agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=email_memory
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ===== Long-term memory =====
# Store namespace: (MEMORY_NAMESPACE, <profile user.id>, <collection>)
MEMORY_NAMESPACE=email_assistant
MEMORY_SEMANTIC_COLLECTION=semantic
MEMORY_EPISODIC_COLLECTION=episodic
# Page size when listing/clearing memories
MEMORY_PAGE_SIZE=100
# Episodic memory (stage 03+): how many similar past emails to show the triage step,
# and the minimum similarity score (0-1) for one to count
EPISODIC_TOP_K=3
EPISODIC_MIN_SCORE=0.75
# ReAct reply agent (stage 04): tool steps before it must draft, review retries before it
# escalates, and how many semantic memories it reads up front
REACT_MAX_STEPS=6
REACT_MAX_REVISIONS=1
REACT_CONTEXT_MEMORIES=5
# Procedural memory (stage 04): live triage rules / agent instructions per user
MEMORY_PROCEDURAL_COLLECTION=procedural
# langmem optimizer strategy: prompt_memory | gradient | metaprompt
PROCEDURAL_OPTIMIZER_KIND=prompt_memory

# ===== Push notifications (stage 04) =====
# Recipients (Telegram chat id) and channels are in the notifications settings.
# true = print notifications instead of sending them
NOTIFY_DRY_RUN=true
# Telegram caps messages at 4096 chars
NOTIFY_MAX_CHARS=4000
# Characters of the email body quoted in "notify" messages
NOTIFY_PREVIEW_CHARS=300
# Max characters of the model's reasoning quoted in a notification
NOTIFY_REASONING_CHARS=500
# Emails per ignored-email digest message (Telegram caps message length)
DIGEST_MAX_ITEMS=10
NOTIFY_TIMEOUT_SECONDS=10
# Telegram Bot API: create a bot with @BotFather and paste its token
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_BOT_TOKEN=
# Listener for 👍/👎 feedback buttons (inside the API; or run `make bot` without the API)
TELEGRAM_LISTENER_ENABLED=true
TELEGRAM_POLL_TIMEOUT=25

# ===== Environment =====
# development | staging | production (any lowercase name): labels every Langfuse trace and
# score and every MLflow run, so cost and quality can be compared per environment
APP_ENV=development

# ===== Langfuse (tracing + prompt history), self-hosted =====
# Server image versions (see docs/LANGFUSE.md before major upgrades)
LANGFUSE_VERSION=4.70.1
CLICKHOUSE_VERSION=25.12
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3000
# Embedding the Langfuse UI in our Visualizations tab: a local proxy that lets only these
# origins frame it (Langfuse itself forbids framing)
LANGFUSE_EMBED_IMAGE=nginx:1.27-alpine
LANGFUSE_EMBED_PORT=3002
LANGFUSE_EMBED_URL=http://localhost:3002
LANGFUSE_EMBED_ORIGINS=http://localhost:5173 http://localhost:8000 http://127.0.0.1:8000
# How long the Visualizations KPIs are cached
VISUALIZATIONS_CACHE_SECONDS=60
LANGFUSE_PORT=3000
LANGFUSE_DB=langfuse
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
# Headless init: org, project, API keys and user are created on first start
LANGFUSE_INIT_ORG_ID=local-org
LANGFUSE_INIT_PROJECT_ID=email-assistant
LANGFUSE_INIT_USER_EMAIL=example@gmail.com
LANGFUSE_INIT_USER_PASSWORD=change-me
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# 64 hex chars (openssl rand -hex 32)
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_CLICKHOUSE_PASSWORD=change-me
LANGFUSE_REDIS_PASSWORD=change-me
LANGFUSE_MINIO_PASSWORD=change-me
LANGFUSE_MINIO_PORT=9090

# ===== MLflow (stage/DAG run tracking + triggering) =====
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_PORT=5000
MLFLOW_EXPERIMENT_NAME=email-assistant
MLFLOW_BACKEND_DB=mlflow
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts

# ===== Gmail worker =====
GMAIL_CREDENTIALS_PATH=secrets/credentials.json
GMAIL_TOKEN_PATH=secrets/token.json
GMAIL_POLL_SECONDS=60
GMAIL_QUERY=is:unread in:inbox
# true = create drafts only, never send
GMAIL_DRY_RUN=true
GMAIL_PROCESSED_LABEL=assistant/processed
# Read-only test run from the UI: how many recent emails, and max body length sent to the model
GMAIL_PREVIEW_COUNT=5
GMAIL_MAX_BODY_CHARS=4000
# Auto-trigger: watch for new emails (Gmail change history) and run the last stage on each.
# GMAIL_WATCHER_ENABLED runs the watcher thread inside the API; GMAIL_AUTO_TRIGGER is its default on/off
# (switched in the UI: Settings -> Gmail). Spam emails are only ever reported, never answered.
GMAIL_WATCHER_ENABLED=true
GMAIL_AUTO_TRIGGER=false
GMAIL_INCLUDE_SPAM=false
GMAIL_SPAM_QUERY=in:spam is:unread
GMAIL_MAX_PER_TICK=5
GMAIL_MAX_ATTEMPTS=3
# used to catch up when Gmail's change history has expired (watcher off for about a week)
GMAIL_HISTORY_FALLBACK_QUERY=newer_than:1d
# JSON list; gmail.modify = read, label, draft and send, no permanent deletion
GMAIL_SCOPES=["https://www.googleapis.com/auth/gmail.modify"]
CALENDAR_SCOPES=["https://www.googleapis.com/auth/calendar"]
# Must be an authorised redirect URI of your Google OAuth client
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8000/api/gmail/oauth/callback

# ===== App / UI =====
# Key for the single local user's config in Postgres
APP_USER_ID=omar
# Fernet key that encrypts secrets saved from the UI (make env generates it)
APP_ENCRYPTION_KEY=
API_HOST=127.0.0.1
API_PORT=8000
UI_PORT=5173
# Where the browser is sent back to after Google sign-in (empty when the API serves the built UI)
UI_BASE_URL=http://localhost:5173
# How long a process trusts its cached copy of the UI-saved config
CONFIG_CACHE_SECONDS=5
HEALTH_TIMEOUT_SECONDS=3

# ===== Python / app =====
PYTHON=python3
VENV=.venv
LOG_LEVEL=INFO

# ===== AppImage packaging (make appimage) =====
# Pinned downloads, verified by SHA256: relocatable CPython (python-build-standalone) and appimagetool
APPIMAGE_PYTHON_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20261009/cpython-3.12.15%2B20261009-x86_64-unknown-linux-gnu-install_only.tar.gz
APPIMAGE_PYTHON_SHA256=5864001bf969db329fadc2b654c4878c6027d170c6bd77e28f88666260bcaf63
APPIMAGETOOL_URL=https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-x86_64.AppImage
APPIMAGETOOL_SHA256=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0
APPIMAGE_BUILD_DIR=build/appimage
APPIMAGE_OUTPUT_DIR=dist
